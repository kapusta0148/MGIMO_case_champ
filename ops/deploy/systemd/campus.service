[Unit]
Description=MGIMO Campus (Gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=campus
Group=campus
WorkingDirectory=/opt/campus/backend
EnvironmentFile=/etc/campus/campus.env
# 2 процесса по 2 потока: хватает для жюри и укладывается в 2 ГБ памяти вместе с PostgreSQL.
ExecStart=/opt/campus/venv/bin/gunicorn wsgi:app --bind 127.0.0.1:8000 --workers 2 --threads 2 --timeout 30 --graceful-timeout 20 --max-requests 2000 --max-requests-jitter 200 --access-logfile - --error-logfile -
Restart=always
RestartSec=3
MemoryMax=700M
# Ограничения на случай уязвимости: процесс не видит домашние каталоги и не пишет вне своих папок.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/campus /opt/campus/backend/instance

[Install]
WantedBy=multi-user.target
