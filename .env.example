# Скопируйте в .env и заполните. Настоящие значения в репозиторий не попадают.

# Flask
APP_ENV=development            # development | production
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
DATABASE_URL=postgresql+psycopg://campus:campus_local_only@127.0.0.1:5433/campus
TEST_DATABASE_URL=postgresql+psycopg://campus:campus_local_only@127.0.0.1:5433/campus_test

# В production за Caddy/Nginx: 1 — доверять заголовкам X-Forwarded-*
TRUST_PROXY=0
# В production обязательно 1 (cookie только по HTTPS)
SESSION_COOKIE_SECURE=0

# Пароли демо-аккаунтов. Если не заданы, `flask seed` сгенерирует случайные
# и сохранит их в backend/instance/demo_credentials.json (файл вне Git).
DEMO_PASSWORD_STUDENT1=
DEMO_PASSWORD_STUDENT2=
DEMO_PASSWORD_DEAN=
DEMO_PASSWORD_TEACHER=
DEMO_PASSWORD_ADMIN=

# AI Planner (необязательно; без ключа работает алгоритмический режим)
AI_API_KEY=
AI_API_BASE_URL=
AI_MONTHLY_BUDGET_RUB=300
